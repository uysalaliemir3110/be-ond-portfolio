# Next.js static export on Apache/cPanel.
#
# Routing needs no rules here: `trailingSlash: true` emits an index.html inside
# every route folder, which Apache's default DirectoryIndex already serves.
# This file only wires up the styled 404 page.

ErrorDocument 404 /404.html

# No directory listings (e.g. /images/archive/), and basic browser hardening.
Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
